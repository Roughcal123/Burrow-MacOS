#!/bin/bash
# Runs as root at the end of BurrowHelper.pkg. Installs the helper tools and the sudoers rule.
set -euo pipefail
SRC=/private/tmp/burrow-helper-payload
D=/usr/local/libexec/burrow
mkdir -p "$D" /etc/sudoers.d
for f in wg wireguard-go burrow-helper.sh; do
  install -o root -g wheel -m 755 "$SRC/$f" "$D/$f"
done
xattr -dr com.apple.quarantine "$D" 2>/dev/null || true
T=$(mktemp)
echo '%admin ALL=(root) NOPASSWD: /usr/local/libexec/burrow/burrow-helper.sh' > "$T"
visudo -cf "$T" >/dev/null
install -o root -g wheel -m 440 "$T" /etc/sudoers.d/burrow
rm -f "$T"
rm -rf "$SRC"
exit 0
